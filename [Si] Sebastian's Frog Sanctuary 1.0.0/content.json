{

	"Format": "2.0.0",

	// Config //////////////////////////////////////////////////////////

	"ConfigSchema":{

		"SebSched": {
			"AllowValues": "true, false",
			"Default": "true",
			"Description": "When disabled, Sebastian will not visit the frog habitats once a month."
		},

		"SebRainSched": {
			"AllowValues": "true, false",
			"Default": "true",
			"Description": "When disabled, Sebastian will not have a 50% chance of visiting the frog habitats on rainy days."
		},

		"VincentSched": {
			"AllowValues": "true, false",
			"Default": "true",
			"Description": "When disabled, Vincent will not visit the frog habitats once a month."
		},

		"VincentRainSched": {
			"AllowValues": "true, false",
			"Default": "true",
			"Description": "When disabled, Vincent will not have a 50% chance of visiting the frog habitats on rainy days."
		},

		"EditEvents": {
			"AllowValues": "true, false",
			"Default": "true",
			"Description": "When disabled, Sebastian's vanilla 14-heart event won't be modified to match this mod."
		},

		"DialoguePatches": {
			"AllowValues": "true, false",
			"Default": "true",
			"Description": "When disabled, dialogue (including marriage dialogue) added by this mod won't be applied. Does not include conversation topics."
		},

		"Froggy": {
			"AllowValues": "true, false",
			"Default": "true",
			"Description": "When disabled, Sebastian will not occasionally call you Froggy as a pet name when married."
		},

		"CrossoverContent": {
			"AllowValues": "true, false",
			"Default": "true",
			"Description": "When disabled, crossover content will not occur. Does not include compatibility patches."
		},
	},

	// Dynamic Tokens //////////////////////////////////////////////////////////

	"DynamicTokens": [

		// Where Seb sleeps - vanilla
		{
			"Name": "SebBed",
			"Value": "SebastianRoom 11 9 1 sebastian_sleep",
			"When": {
				"HasMod |contains=kcspace.StarCrossed": false,
			},
		},
		// Where Seb sleeps - Star Crossed by kcspace
		{
			"Name": "SebBed",
			"Value": "SebastianRoom 11 9 1 sebastian_sleep",
			"When": {
				"HasMod |contains=kcspace.StarCrossed": true,
				"HasSeenEvent:hostPlayer |contains=SebastianAbigailWedding": false,
			},
		},
		{
			"Name": "SebBed",
			"Value": "SebastianRoom 10 9 1 sebastian_sleep",
			"When": {
				"HasMod |contains=kcspace.StarCrossed": true,
				"HasSeenEvent:hostPlayer |contains=SebastianAbigailWedding": true,
			},
		},
	],

	"Changes": [

		// Base Content //////////////////////////////////////////////////////////

		{
			"LogName": "Si SF Base Content",
			"Action": "Include",
			"FromFile": "Assets/Base/Si_SF.json",
			"When": {
				"HasSeenEvent:hostPlayer |contains=29": true,
			}
		},

		// Compatibility Patches //////////////////////////////////////////////////////////

		{
			"LogName": "Si SF Compat Patches",
			"Action": "Include",
			"FromFile": "Assets/Compats/Si_SF_Compats.json",
			"When": {
				"HasSeenEvent:hostPlayer |contains=29": true,
			}
		},

		// Crossovers //////////////////////////////////////////////////////////

		{
			"LogName": "Si SF Crossover Content",
			"Action": "Include",
			"FromFile": "Assets/Crossovers/Si_SF_Crossovers.json",
			"When": {
				"CrossoverContent": true
			}
		},

		// End //////////////////////////////////////////////////////////

	]

}